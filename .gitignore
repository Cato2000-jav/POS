# Entornos virtuales de Python: se reconstruyen con requirements.txt.
.venv/
venv/

# Archivos temporales que genera Python al ejecutar el backend.
__pycache__/
*.py[cod]

# Configuración privada. El ejemplo sin credenciales sí se comparte.
.env
.env.*
!.env.example

# Base SQLite local de desarrollo y sus archivos auxiliares.
/backend/db.sqlite3
/backend/db.sqlite3-journal
/backend/db.sqlite3-wal
/backend/db.sqlite3-shm

# Archivos de prueba y metadatos locales.
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# Archivos locales del MVP 3
backend/.secret-local
backend/staticfiles/
*.sqlite3
*.sqlite3-*
entrega/
