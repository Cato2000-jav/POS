# Plantilla: configura estos valores en el alojamiento; no se carga automáticamente.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_PRIVADA_ESTABLE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tu-dominio.example
CSRF_TRUSTED_ORIGINS=https://tu-dominio.example
HTTPS_ONLY=true
TRUST_PROXY=true
POSTGRES_DB=papelluna
POSTGRES_USER=papelluna
POSTGRES_PASSWORD=REEMPLAZAR
POSTGRES_HOST=REEMPLAZAR
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
# Render proporciona DATABASE_URL automáticamente mediante render.yaml.
# Si se define, tiene prioridad sobre POSTGRES_*.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE
POS_ADMIN_PASSWORD=REEMPLAZAR_POR_CLAVE_SEGURA
POS_CAJERO_PASSWORD=REEMPLAZAR_POR_CLAVE_SEGURA
